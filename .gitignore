# Dependencies
node_modules/
server/node_modules/
server/dist/

# Local npm cache (used when the sandbox blocks the global ~/.npm cache)
.npm-cache/

# Build outputs
dist/
build/
apk-out/

# Android native shell is COMMITTED (icons and manifest).
# Signing material is injected by private CI secrets and must never be tracked.
android/keystore.properties
android/keystore/
# Only ignore generated build artifacts and local machine state.
android/.gradle/
android/local.properties
android/**/build/
android/.idea/
android/captures/
android/.externalNativeBuild/
android/app/schemas/
android/.cxx/

# iOS native shell (not committed)
ios/

# Local agent planning notes
.kilo/
memories/
opencode.json

# Cloudflare Workers build artifacts
worker/.wrangler/
worker/dist/

# Environment files
.env
.env.local
.env.*.local

# IDE / Editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite cache
.vite/
