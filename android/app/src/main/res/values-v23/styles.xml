<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 23+ refinements for AppTheme.NoActionBar. `windowLightStatusBar`
         uses dark status-bar icons on the cream `@color/app_bg` bar (API 23+
         only; guarded here so API 22 keeps the default light icons). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
    </style>

</resources>