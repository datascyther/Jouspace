{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd server && npm run dev",
    "dev:all": "kill $(lsof -ti:3001) 2>/dev/null; concurrently --names \"vite,runtime\" --prefix-colors \"cyan,magenta\" \"npm run dev\" \"npm run server\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/local-notifications": "^6.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.28.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@huggingface/hub": "^0.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.1.2",
    "jsdom": "25.0.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10"
  }
}
